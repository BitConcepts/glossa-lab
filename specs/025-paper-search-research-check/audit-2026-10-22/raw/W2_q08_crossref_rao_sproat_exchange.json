"{\n  \"paper_id\": \"10.1162/coli_c_00030\",\n  \"title\": \"Entropy, the Indus Script, and Language:A Reply to R. Sproat\",\n  \"authors\": \"Rajesh P. N. Rao; Nisha Yadav; Mayank N. Vahia; Hrishikesh Joglekar; Ronojoy Adhikari; Iravatham Mahadevan\",\n  \"abstract\": \"\",\n  \"doi\": \"10.1162/coli_c_00030\",\n  \"published_date\": \"2010-12-01T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.1162/coli_c_00030\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 16,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'MIT Press - Journals', 'container_title': 'Computational Linguistics', 'volume': '36', 'issue': '4', 'page': '795-805', 'issn': ['0891-2017', '1530-9312'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '281', 'prefix': '10.1162'}\"\n}\n{\n  \"paper_id\": \"10.1126/science.1170391\",\n  \"title\": \"Entropic Evidence for Linguistic Structure in the Indus Script\",\n  \"authors\": \"Rajesh P. N. Rao; Nisha Yadav; Mayank N. Vahia; Hrishikesh Joglekar; R. Adhikari; Iravatham Mahadevan\",\n  \"abstract\": \"<jats:p>Analysis of the pattern of symbols confirms the linguistic role of ancient signs.</jats:p>\",\n  \"doi\": \"10.1126/science.1170391\",\n  \"published_date\": \"2009-05-29T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.1126/science.1170391\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 47,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'American Association for the Advancement of Science (AAAS)', 'container_title': 'Science', 'volume': '324', 'issue': '5931', 'page': '1165-1165', 'issn': ['0036-8075', '1095-9203'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '221', 'prefix': '10.1126'}\"\n}\n{\n  \"paper_id\": \"10.21275/sr251216111751\",\n  \"title\": \"Sanskrit Influence on the Indus Script\",\n  \"authors\": \"Jeyakumar Ramasami\",\n  \"abstract\": \"\",\n  \"doi\": \"10.21275/sr251216111751\",\n  \"published_date\": \"2025-12-20T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.21275/sr251216111751\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'International Journal of Science and Research', 'container_title': 'International Journal of Science and Research (IJSR)', 'volume': '', 'issue': '', 'page': '1329-1334', 'issn': ['2319-7064'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '8810', 'prefix': '10.21275'}\"\n}\n{\n  \"paper_id\": \"10.1038/nindia.2009.147\",\n  \"title\": \"Write signs for Indus script?\",\n  \"authors\": \"\",\n  \"abstract\": \"\",\n  \"doi\": \"10.1038/nindia.2009.147\",\n  \"published_date\": \"2009-05-31T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.1038/nindia.2009.147\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Springer Science and Business Media LLC', 'container_title': 'Nature India', 'volume': '', 'issue': '', 'page': '', 'issn': ['1755-3180'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '297', 'prefix': '10.1038'}\"\n}\n{\n  \"paper_id\": \"10.1038/nindia.2009.128\",\n  \"title\": \"Indus valley script is linguistic\",\n  \"authors\": \"\",\n  \"abstract\": \"\",\n  \"doi\": \"10.1038/nindia.2009.128\",\n  \"published_date\": \"2009-05-08T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.1038/nindia.2009.128\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Springer Science and Business Media LLC', 'container_title': 'Nature India', 'volume': '', 'issue': '', 'page': '', 'issn': ['1755-3180'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '297', 'prefix': '10.1038'}\"\n}\n{\n  \"paper_id\": \"10.31219/osf.io/aqey4\",\n  \"title\": \"Indus script Decipherment\",\n  \"authors\": \"Ramkumar Unnipillai Santhakumari\",\n  \"abstract\": \"<p>A  partial decipherment of the  Indus script is described here. Similarities between Protocuneiform characters and Indus script characters were observed. Transferring meanings  from Protocuneiform to Indus script characters using ProtoDravidian sounds  resulted in meaningful readings .  These meanings as well as relations observed between Indus script and Brahmi script are described here.</p>\",\n  \"doi\": \"10.31219/osf.io/aqey4\",\n  \"published_date\": \"2019-10-02T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.31219/osf.io/aqey4\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"posted-content\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Center for Open Science', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'posted-content', 'member': '15934', 'prefix': '10.31219'}\"\n}\n{\n  \"paper_id\": \"10.31219/osf.io/4rga5_v1\",\n  \"title\": \"Deciphering the Indus Script\",\n  \"authors\": \"Milind Raskar\",\n  \"abstract\": \"<p>AbstractDeciphering Indus script was long a challenge for experts because of the complex structure of its clusters of signs, its inconspicuous traces in both past known scripts and scripts currently used in the Indian subcontinent, and the paradigms about potential Indus languages. Purpose of this study, is to extract the Indus letters from the common graphemes of synonymous words from different known Indian languages, depicting the pictographic signs present on Indus seals using the concept of the contemporary Egyptian hieroglyphic writing system. Furthermore, this study determined the reading sequence of the signs present in the clusters of the Indus seals. According to the findings, the language used by the Indus people is Proto-Pali, which uses an Abugida-type writing system with five vowels and eighteen consonants. Clusters of the signs are conjunct consonants or compound words that use diacritic syllables similar to the existing Indian subcontinent scripts. These findings will help reveal the previously occluded history of the Indus people and their historical relationship with existing Indian scripts, languages and culture.</p>\",\n  \"doi\": \"10.31219/osf.io/4rga5_v1\",\n  \"published_date\": \"2022-08-04T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.31219/osf.io/4rga5_v1\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"posted-content\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Center for Open Science', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'posted-content', 'member': '15934', 'prefix': '10.31219'}\"\n}\n{\n  \"paper_id\": \"10.31219/osf.io/aqey4_v1\",\n  \"title\": \"Indus script Decipherment\",\n  \"authors\": \"Ramkumar Unnipillai Santhakumari\",\n  \"abstract\": \"<p>A  partial decipherment of the  Indus script is described here. Similarities between Protocuneiform characters and Indus script characters were observed. Transferring meanings  from Protocuneiform to Indus script characters using ProtoDravidian sounds  resulted in meaningful readings .  These meanings as well as relations observed between Indus script and Brahmi script are described here.</p>\",\n  \"doi\": \"10.31219/osf.io/aqey4_v1\",\n  \"published_date\": \"2019-10-02T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.31219/osf.io/aqey4_v1\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"posted-content\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Center for Open Science', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'posted-content', 'member': '15934', 'prefix': '10.31219'}\"\n}\n{\n  \"paper_id\": \"10.1063/pt.4.0677\",\n  \"title\": \"Statistically  speaking, Indus script is a language\",\n  \"authors\": \"Steven K. Blau\",\n  \"abstract\": \"\",\n  \"doi\": \"10.1063/pt.4.0677\",\n  \"published_date\": \"2009-04-27T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.1063/pt.4.0677\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'AIP Publishing', 'container_title': 'Physics Today', 'volume': '2009', 'issue': '04', 'page': '', 'issn': ['1945-0699'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '317', 'prefix': '10.1063'}\"\n}\n{\n  \"paper_id\": \"10.2307/j.ctvzgb7m5.8\",\n  \"title\": \"The Buddhist Indus Script\",\n  \"authors\": \"\",\n  \"abstract\": \"\",\n  \"doi\": \"10.2307/j.ctvzgb7m5.8\",\n  \"published_date\": \"2020-03-26T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2307/j.ctvzgb7m5.8\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"book-chapter\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Harrassowitz Verlag', 'container_title': 'The Buddhist Indus Script and Scriptures', 'volume': '', 'issue': '', 'page': '9-64', 'issn': [], 'isbn': [], 'crossref_type': 'book-chapter', 'member': '1121', 'prefix': '10.2307'}\"\n}"
