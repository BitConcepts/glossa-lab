: \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"reference-entry\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Springer-Verlag', 'container_title': 'SpringerReference', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'reference-entry', 'member': '297', 'prefix': '10.1007'}\"\n}\n{\n  \"paper_id\": \"10.2307/j.ctvr43jmf.9\",\n  \"title\": \"The Indus Valley Script\",\n  \"authors\": \"\",\n  \"abstract\": \"\",\n  \"doi\": \"10.2307/j.ctvr43jmf.9\",\n  \"published_date\": \"2015-02-06T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2307/j.ctvr43jmf.9\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"book-chapter\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Archaeopress Publishing Ltd', 'container_title': 'The Archaeology and Epigraphy of Indus Writing', 'volume': '', 'issue': '', 'page': '4-12', 'issn': [], 'isbn': [], 'crossref_type': 'book-chapter', 'member': '1121', 'prefix': '10.2307'}\"\n}\n{\n  \"paper_id\": \"10.6028/nbs.mp.135\",\n  \"title\": \"The international metric system of weights and measures/\",\n  \"authors\": \"William Parry\",\n  \"abstract\": \"\",\n  \"doi\": \"10.6028/nbs.mp.135\",\n  \"published_date\": \"1932-01-01T00:00:00\",\n  \"pdf_url\": \"https://nvlpubs.nist.gov/nistpubs/Legacy/MP/nbsmiscellaneouspub135.pdf\",\n  \"url\": \"https://doi.org/10.6028/nbs.mp.135\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"report\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'National Institute of Standards and Technology', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'report', 'member': '4068', 'prefix': '10.6028'}\"\n}\n{\n  \"paper_id\": \"10.2139/ssrn.4900721\",\n  \"title\": \"Deciphering Indus script and Pashupati Seal of Indus Valley Civilization\",\n  \"authors\": \"Shahbaig Kahoor Khan\",\n  \"abstract\": \"<jats:p>Indus Valley Civilization is one of the left out archaeological treasures, that is being ignored in the recent times. This paper is a guide to the scholars and the archaeologist, which will help them to solve the mysteries of the ancient Indus Civilization and its Script. The paper includes thorough research observations on the interpretation of the scripts. Among the script and the famous Pashupati seal has also been thoroughly interpreted and explained. This could be a guide to interpret Indus customs and culture more nearer to the truth of past. The political controversies altering the history of Indus can cause a tremendous if not correctly study.</jats:p>\",\n  \"doi\": \"10.2139/ssrn.4900721\",\n  \"published_date\": \"2024-01-01T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2139/ssrn.4900721\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"posted-content\",\n  \"keywords\": \"\",\n  \"citations\": 1,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Elsevier BV', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'posted-content', 'member': '78', 'prefix': '10.2139'}\"\n}"
