"{\n  \"paper_id\": \"10.1162/coli_c_00030\",\n  \"title\": \"Entropy, the Indus Script, and Language:A Reply to R. Sproat\",\n  \"authors\": \"Rajesh P. N. Rao; Nisha Yadav; Mayank N. Vahia; Hrishikesh Joglekar; Ronojoy Adhikari; Iravatham Mahadevan\",\n  \"abstract\": \"\",\n  \"doi\": \"10.1162/coli_c_00030\",\n  \"published_date\": \"2010-12-01T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.1162/coli_c_00030\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 16,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'MIT Press - Journals', 'container_title': 'Computational Linguistics', 'volume': '36', 'issue': '4', 'page': '795-805', 'issn': ['0891-2017', '1530-9312'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '281', 'prefix': '10.1162'}\"\n}\n{\n  \"paper_id\": \"10.2307/j.ctvzgb7m5.8\",\n  \"title\": \"The Buddhist Indus Script\",\n  \"authors\": \"\",\n  \"abstract\": \"\",\n  \"doi\": \"10.2307/j.ctvzgb7m5.8\",\n  \"published_date\": \"2020-03-26T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2307/j.ctvzgb7m5.8\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"book-chapter\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Harrassowitz Verlag', 'container_title': 'The Buddhist Indus Script and Scriptures', 'volume': '', 'issue': '', 'page': '9-64', 'issn': [], 'isbn': [], 'crossref_type': 'book-chapter', 'member': '1121', 'prefix': '10.2307'}\"\n}\n{\n  \"paper_id\": \"10.5120/ijca2025926075\",\n  \"title\": \"A Computational Analysis of the Indus Script: Identifying Sign Functions in Logo-Syllabic Writing Systems\",\n  \"authors\": \"Ruhan Khanna; Louie Merriam\",\n  \"abstract\": \"\",\n  \"doi\": \"10.5120/ijca2025926075\",\n  \"published_date\": \"2025-12-18T00:00:00\",\n  \"pdf_url\": \"https://ijcaonline.org/archives/volume187/number64/khanna-2025-ijca-926075.pdf\",\n  \"url\": \"https://doi.org/10.5120/ijca2025926075\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Foundation of Computer Science', 'container_title': 'International Journal of Computer Applications', 'volume': '187', 'issue': '64', 'page': '19-22', 'issn': ['0975-8887'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '3103', 'prefix': '10.5120'}\"\n}\n{\n  \"paper_id\": \"10.2307/j.ctvr43jmf.9\",\n  \"title\": \"The Indus Valley Script\",\n  \"authors\": \"\",\n  \"abstract\": \"\",\n  \"doi\": \"10.2307/j.ctvr43jmf.9\",\n  \"published_date\": \"2015-02-06T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2307/j.ctvr43jmf.9\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"book-chapter\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Archaeopress Publishing Ltd', 'container_title': 'The Archaeology and Epigraphy of Indus Writing', 'volume': '', 'issue': '', 'page': '4-12', 'issn': [], 'isbn': [], 'crossref_type': 'book-chapter', 'member': '1121', 'prefix': '10.2307'}\"\n}\n{\n  \"paper_id\": \"10.2139/ssrn.4900721\",\n  \"title\": \"Deciphering Indus script and Pashupati Seal of Indus Valley Civilization\",\n  \"authors\": \"Shahbaig Kahoor Khan\",\n  \"abstract\": \"<jats:p>Indus Valley Civilization is one of the left out archaeological treasures, that is being ignored in the recent times. This paper is a guide to the scholars and the archaeologist, which will help them to solve the mysteries of the ancient Indus Civilization and its Script. The paper includes thorough research observations on the interpretation of the scripts. Among the script and the famous Pashupati seal has also been thoroughly interpreted and explained. This could be a guide to interpret Indus customs and culture more nearer to the truth of past. The political controversies altering the history of Indus can cause a tremendous if not correctly study.</jats:p>\",\n  \"doi\": \"10.2139/ssrn.4900721\",\n  \"published_date\": \"2024-01-01T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2139/ssrn.4900721\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"posted-content\",\n  \"keywords\": \"\",\n  \"citations\": 1,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Elsevier BV', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'posted-content', 'member': '78', 'prefix': '10.2139'}\"\n}\n{\n  \"paper_id\": \"10.21275/sr251216111751\",\n  \"title\": \"Sanskrit Influence on the Indus Script\",\n  \"authors\": \"Jeyakumar Ramasami\",\n  \"abstract\": \"\",\n  \"doi\": \"10.21275/sr251216111751\",\n  \"published_date\": \"2025-12-20T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.21275/sr251216111751\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"journal-article\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'International Journal of Science and Research', 'container_title': 'International Journal of Science and Research (IJSR)', 'volume': '', 'issue': '', 'page': '1329-1334', 'issn': ['2319-7064'], 'isbn': [], 'crossref_type': 'journal-article', 'member': '8810', 'prefix': '10.21275'}\"\n}\n{\n  \"paper_id\": \"10.2139/ssrn.7436801\",\n  \"title\": \"Sequential Structure Without a Linguistic Diagnosis: A Falsification-Oriented Analysis of the Indus Script\",\n  \"authors\": \"Joy Bose\",\n  \"abstract\": \"<jats:p>The Indus Valley script remains undeciphered. Under ordinary cross-validated scoring, real Indus sign sequences show a positive trigram-over-bigram predictive gain (the two preceding signs predict the next sign better than one preceding sign alone), replicating closely across two independently extracted digitizations of the same underlying corpus tradition, including the M77 corpus corresponding to the concordance behind the most cited statistical studies of the script (+0.143 and +0.158 bits), and clearing 200-trial null distributions entirely. However, both corpora contain substantial exact-sequence repetition (23 to 33 percent of sequences). When cross-validation folds are constructed so duplicate sequences cannot appear in both training and their own held-out evaluation, the gain reverses sign for both corpora (-0.088,-0.083); when duplicates are instead collapsed to unique sequence types, it weakens to near zero (-0.023,-0.010). A control experiment, grouping sequences of the same size distribution but without duplicate identity, stays strongly positive, ruling out the alternative explanation that this reversal simply reflects smaller effective training sets rather than duplicate identity specifically. This is not a data-handling error, since the repetition is a genuine corpus property, but it means the ordinary-CV result should not be read as established evidence of sequential structure that generalizes to novel sequences, and we treat resolving this as the paper's central open problem. Independently of that question, our most specific test among the mechanisms we examined shows the ordinary-CV gain is not uniquely diagnostic of the particular linguistic generative mechanism we tested, including after rebuilding that generator and a non-linguistic alternative to match the real corpus's own vocabulary and length statistics; neither reproduces the real magnitude in matched or unmatched form. A sample-size curve on two calibration languages shows this estimator rarely returns a positive result below roughly 3,000 sequences for either, evidence against the ordinary-CV result being generic small-sample behavior. We also find evidence against inscriptions being deliberately constructed as globally unique identifiers, though not against more elaborate identifier schemes. The framework, derived corpora where licensing permits, and all experiments are released openly.</jats:p>\",\n  \"doi\": \"10.2139/ssrn.7436801\",\n  \"published_date\": \"2026-01-01T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2139/ssrn.7436801\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"posted-content\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Elsevier BV', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'posted-content', 'member': '78', 'prefix': '10.2139'}\"\n}\n{\n  \"paper_id\": \"10.31235/osf.io/3amvt_v1\",\n  \"title\": \"Sequential Structure Without a Linguistic Diagnosis: A Falsification-Oriented Analysis of the Indus Script\",\n  \"authors\": \"Joy Bose\",\n  \"abstract\": \"<p>The Indus Valley script remains undeciphered. Under ordinary cross-validated scoring, real Indus sign sequences show a positive trigram-over-bigram predictive gain (the two preceding signs predict the next sign better than one preceding sign alone), replicating closely across two independently extracted digitizations of the same underlying corpus tradition, including the M77 corpus corresponding to the concordance behind the most cited statistical studies of the script (+0.143 and +0.158 bits), and clearing 200-trial null distributions entirely. However, both corpora contain substantial exact-sequence repetition (23 to 33 percent of sequences). When cross-validation folds are constructed so duplicate sequences cannot appear in both training and their own held-out evaluation, the gain reverses sign for both corpora (-0.088, -0.083); when duplicates are instead collapsed to unique sequence types, it weakens to near zero (-0.023, -0.010). A control experiment, grouping sequences of the same size distribution but without duplicate identity, stays strongly positive, ruling out the alternative explanation that this reversal simply reflects smaller effective training sets rather than duplicate identity specifically. This is not a data-handling error, since the repetition is a genuine corpus property, but it means the ordinary-CV result should not be read as established evidence of sequential structure that generalizes to novel sequences, and we treat resolving this as the paper's central open problem. Independently of that question, our most specific test among the mechanisms we examined shows the ordinary-CV gain is not uniquely diagnostic of the particular linguistic generative mechanism we tested, including after rebuilding that generator and a non-linguistic alternative to match the real corpus's own vocabulary and length statistics; neither reproduces the real magnitude in matched or unmatched form. A sample-size curve on two calibration languages shows this estimator rarely returns a positive result below roughly 3,000 sequences for either, evidence against the ordinary-CV result being generic small-sample behavior. We also find evidence against inscriptions being deliberately constructed as globally unique identifiers, though not against more elaborate identifier schemes. The framework, derived corpora where licensing permits, and all experiments are released openly.</p>\",\n  \"doi\": \"10.31235/osf.io/3amvt_v1\",\n  \"published_date\": \"2026-09-09T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.31235/osf.io/3amvt_v1\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"posted-content\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Center for Open Science', 'container_title': '', 'volume': '', 'issue': '', 'page': '', 'issn': [], 'isbn': [], 'crossref_type': 'posted-content', 'member': '15934', 'prefix': '10.31235'}\"\n}\n{\n  \"paper_id\": \"10.2307/j.ctvr43jmf.14\",\n  \"title\": \"Proto-Dravidian and the Indus Script\",\n  \"authors\": \"\",\n  \"abstract\": \"\",\n  \"doi\": \"10.2307/j.ctvr43jmf.14\",\n  \"published_date\": \"2015-02-06T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.2307/j.ctvr43jmf.14\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"book-chapter\",\n  \"keywords\": \"\",\n  \"citations\": 0,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Archaeopress Publishing Ltd', 'container_title': 'The Archaeology and Epigraphy of Indus Writing', 'volume': '', 'issue': '', 'page': '77-99', 'issn': [], 'isbn': [], 'crossref_type': 'book-chapter', 'member': '1121', 'prefix': '10.2307'}\"\n}\n{\n  \"paper_id\": \"10.1093/acprof:oso/9780190226909.003.0005\",\n  \"title\": \"The Indus Religion and the Indus Script\",\n  \"authors\": \"Asko Parpola\",\n  \"abstract\": \"\",\n  \"doi\": \"10.1093/acprof:oso/9780190226909.003.0005\",\n  \"published_date\": \"2015-09-01T00:00:00\",\n  \"pdf_url\": \"\",\n  \"url\": \"https://doi.org/10.1093/acprof:oso/9780190226909.003.0005\",\n  \"source\": \"crossref\",\n  \"updated_date\": \"\",\n  \"categories\": \"book-chapter\",\n  \"keywords\": \"\",\n  \"citations\": 1,\n  \"references\": \"\",\n  \"extra\": \"{'publisher': 'Oxford University Press', 'container_title': 'The Roots of Hinduism', 'volume': '', 'issue': '', 'page': '25-32', 'issn': [], 'isbn': [], 'crossref_type': 'book-chapter', 'member': '286', 'prefix': '10.1093'}\"\n}"
